*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT DROP [0:0]

# Allow loopback
-A INPUT -i lo -j ACCEPT
-A OUTPUT -o lo -j ACCEPT

# Allow established connections
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A OUTPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT

# Allow Tailscale mesh UDP 41641
-A INPUT -p udp --dport 41641 -j ACCEPT
-A OUTPUT -p udp --sport 41641 -j ACCEPT

# Allow challenge services on Tailscale interface (tailscale0)
-A INPUT -i tailscale0 -p tcp --dport 22 -j ACCEPT
-A INPUT -i tailscale0 -p tcp --dport 8080 -j ACCEPT

# Anti-lateral movement: explicitly block private RFC1918 and public WAN
-A OUTPUT -d 10.0.0.0/8 -j REJECT --reject-with icmp-net-prohibited
-A OUTPUT -d 172.16.0.0/12 -j REJECT --reject-with icmp-net-prohibited
-A OUTPUT -d 192.168.0.0/16 -j REJECT --reject-with icmp-net-prohibited

COMMIT
